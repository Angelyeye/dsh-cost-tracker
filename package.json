{
  "name": "@angelyeye/dsh-cost-tracker",
  "version": "1.7.1",
  "description": "DeepSeek Harness (DSH) plugin: LLM token usage & cost tracking with a settings dashboard, agent tools, HTTP API and persistent storage.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "store.js",
    "pricing.js",
    "config.js",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/storage.test.js && node test/pricing.test.js && node test/config.test.js && node test/recompute.test.js && node test/client-registration.test.js"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "cordis",
    "llm",
    "token-usage",
    "cost-tracking"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.1.0-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Angelyeye/dsh-cost-tracker.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
